      "emailVerified": true,
      "firstName": "Analyst",
      "lastName": "User",
      "email": "analyst@signal-console.local",
      "disableableCredentialTypes": [],
      "requiredActions": [],
      "notBefore": 0,
      "access": {
        "manageGroupMembership": true,
        "view": true,
        "mapRoles": true,
