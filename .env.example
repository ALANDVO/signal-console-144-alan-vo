# Application
APP_NAME=signal-console
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# OIDC / Keycloak (configure for production)
OIDC_ISSUER_URL=http://localhost:8080/realms/signal-console
OIDC_CLIENT_ID=signal-console
OIDC_CLIENT_SECRET=signal-console-secret-change-in-production
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_SCOPES=openid profile email roles

# Session
SESSION_SECRET_KEY=your-secure-random-secret-key-here-min-32-chars
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# LLM Providers (configure as needed)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=30.0

# Demo mode (disable in production)
DEMO_MODE=true